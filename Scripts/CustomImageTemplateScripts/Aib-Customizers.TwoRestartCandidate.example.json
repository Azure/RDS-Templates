{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "twoRestartStageInputsWrapperScriptUri": {
      "type": "string",
      "defaultValue": "<https-two-restart-candidate-stage-inputs-wrapper-uri>"
    },
    "twoRestartStageInputsWrapperScriptSha256": {
      "type": "string",
      "defaultValue": "<two-restart-candidate-stage-inputs-wrapper-sha256>"
    },
    "twoRestartInstallAndServiceWrapperScriptUri": {
      "type": "string",
      "defaultValue": "<https-two-restart-candidate-install-and-service-wrapper-uri>"
    },
    "twoRestartInstallAndServiceWrapperScriptSha256": {
      "type": "string",
      "defaultValue": "<two-restart-candidate-install-and-service-wrapper-sha256>"
    },
    "applyMachineLanguageWrapperScriptUri": {
      "type": "string",
      "defaultValue": "<https-apply-machine-language-wrapper-uri>"
    },
    "applyMachineLanguageWrapperScriptSha256": {
      "type": "string",
      "defaultValue": "<apply-machine-language-wrapper-sha256>"
    },
    "validateWrapperScriptUri": {
      "type": "string",
      "defaultValue": "<https-validate-wrapper-uri>"
    },
    "validateWrapperScriptSha256": {
      "type": "string",
      "defaultValue": "<validate-wrapper-sha256>"
    },
    "restartTimeout": {
      "type": "string",
      "defaultValue": "30m"
    },
    "sourceVariant": {
      "type": "string",
      "defaultValue": "<Gen1-Gen2-or-MultiSession>"
    }
  },
  "resources": [
    {
      "type": "Microsoft.VirtualMachineImages/imageTemplates",
      "apiVersion": "2024-02-01",
      "name": "<two-restart-candidate-image-template-name>",
      "location": "<image-template-location>",
      "tags": {
        "purpose": "cit-language-two-restart-candidate",
        "qualification": "true",
        "productionApproved": "false",
        "candidatePackageSha256": "<candidate-release-zip-sha256>"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "<image-template-managed-identity-resource-id>": {}
        }
      },
      "properties": {
        "buildTimeoutInMinutes": 240,
        "vmProfile": {
          "userAssignedIdentities": [
            "<build-vm-managed-identity-resource-id>"
          ]
        },
        "source": {
          "type": "PlatformImage",
          "publisher": "<source-publisher>",
          "offer": "<source-offer>",
          "sku": "<windows-10-19044-or-19045-sku>",
          "version": "<source-version>"
        },
        "customize": [
          {
            "type": "PowerShell",
            "name": "Language-Candidate-1-StageInputs",
            "runElevated": true,
            "runAsSystem": true,
            "scriptUri": "[parameters('twoRestartStageInputsWrapperScriptUri')]",
            "sha256Checksum": "[parameters('twoRestartStageInputsWrapperScriptSha256')]"
          },
          {
            "type": "PowerShell",
            "name": "Language-Candidate-2-InstallAndService",
            "runElevated": true,
            "runAsSystem": true,
            "scriptUri": "[parameters('twoRestartInstallAndServiceWrapperScriptUri')]",
            "sha256Checksum": "[parameters('twoRestartInstallAndServiceWrapperScriptSha256')]"
          },
          {
            "type": "WindowsRestart",
            "name": "Language-Candidate-3-RestartAfterServicing",
            "restartCommand": "shutdown.exe /r /f /t 0 /c \"AIB language servicing restart\"",
            "restartCheckCommand": "powershell.exe -NoProfile -Command \"Start-Sleep -Seconds 180; Get-Service WinRM | Where-Object Status -eq 'Running'\"",
            "restartTimeout": "[parameters('restartTimeout')]"
          },
          {
            "type": "PowerShell",
            "name": "Language-Candidate-4-ApplyMachineLanguage",
            "runElevated": true,
            "runAsSystem": true,
            "scriptUri": "[parameters('applyMachineLanguageWrapperScriptUri')]",
            "sha256Checksum": "[parameters('applyMachineLanguageWrapperScriptSha256')]"
          },
          {
            "type": "WindowsRestart",
            "name": "Language-Candidate-5-RestartAfterMachineLanguage",
            "restartCommand": "shutdown.exe /r /f /t 0 /c \"AIB machine language restart\"",
            "restartCheckCommand": "powershell.exe -NoProfile -Command \"Start-Sleep -Seconds 180; Get-Service WinRM | Where-Object Status -eq 'Running'\"",
            "restartTimeout": "[parameters('restartTimeout')]"
          },
          {
            "type": "PowerShell",
            "name": "Language-Candidate-6-Validate",
            "runElevated": true,
            "runAsSystem": true,
            "scriptUri": "[parameters('validateWrapperScriptUri')]",
            "sha256Checksum": "[parameters('validateWrapperScriptSha256')]"
          }
        ],
        "distribute": [
          {
            "type": "SharedImage",
            "galleryImageId": "<candidate-gallery-image-definition-resource-id>",
            "runOutputName": "<isolated-two-restart-candidate-run-output-name>",
            "artifactTags": {
              "qualification": "cit-language-two-restart-candidate",
              "productionApproved": "false",
              "sourceVariant": "[parameters('sourceVariant')]"
            },
            "replicationRegions": [
              "<gallery-replication-region>"
            ],
            "excludeFromLatest": true
          }
        ]
      }
    }
  ]
}
